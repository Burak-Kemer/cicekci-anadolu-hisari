# Bu klasörde herhangi bir PHP dosyasının çalıştırılmasını engeller.
# Yüklenen dosya üzerinden kod çalıştırma (RCE) saldırılarına karşı temel önlem.

<IfModule mod_authz_core.c>
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.php$">
        Order allow,deny
        Deny from all
    </FilesMatch>
</IfModule>
